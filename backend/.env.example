APP_NAME="Huller Abang"
APP_ENV=local
# Dibuat otomatis oleh `php artisan key:generate` (composer setup / CI). Jangan isi kunci asli di file contoh ini.
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=huller_abang
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

FRONTEND_URL=http://localhost:5173

# Masa berlaku token login dalam menit (10080 = 7 hari)
SANCTUM_EXPIRATION=10080

OWNER_USERNAME=owner
OWNER_PASSWORD=
